{
  "folders": [
    {
      "name": "Train Simulator",
      "path": ".",
    },
  ],
  "extensions": {
    "recommendations": [
      // Rust language support
      "rust-lang.rust-analyzer",
      // Rust debugger
      "vadimcn.vscode-lldb",
      // Java language support
      "vscjava.vscode-java-pack",
      // Interfacing with Gradle
      "richardwillis.vscode-gradle-extension-pack",
    ],
  },
  "settings": {
    "editor.formatOnSave": true,
    "rust-analyzer.check.command": "clippy",
    "java.configuration.updateBuildConfiguration": "automatic",
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "☕ Simple (Slug)",
        "request": "launch",
        "mainClass": "cp26.Simulator",
        "args": "--scenario scenarios/public/simple.json --out out/simple.result.json --slug",
      },
      {
        "type": "java",
        "name": "☕ Simple (Rocket)",
        "request": "launch",
        "mainClass": "cp26.Simulator",
        "args": "--scenario scenarios/public/simple.json --out out/simple.result.json --rocket",
      },
      {
        "type": "lldb",
        "request": "launch",
        "name": "🦀 Simple (Slug)",
        "cargo": {
          "args": [
            "build",
            "--release",
            "--manifest-path=${workspaceFolder}/Cargo.toml",
          ],
          "filter": {
            "name": "train-sim",
            "kind": "bin",
          },
        },
        "args": [
          "--slug",
          "--scenario=scenarios/public/simple.json",
          "--out=out/simple.result.json",
        ],
        "cwd": "${workspaceFolder}",
      },
      {
        "type": "lldb",
        "request": "launch",
        "name": "🦀 Simple (Rocket)",
        "cargo": {
          "args": [
            "build",
            "--release",
            "--manifest-path=${workspaceFolder}/Cargo.toml",
          ],
          "filter": {
            "name": "train-sim",
            "kind": "bin",
          },
        },
        "args": [
          "--rocket",
          "--scenario=scenarios/public/simple.json",
          "--out=out/simple.result.json",
        ],
        "cwd": "${workspaceFolder}",
      },
    ],
    "compounds": [],
  },
}